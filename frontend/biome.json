{
  "$schema": "https://biomejs.dev/schemas/1.5.3/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error"
      },
      "suspicious": {
        "noConsole": "off",
        "noDebugger": "error"
      },
      "style": {
        "useConsistentArrayType": "error",
        "useShorthandArrayType": "error"
      },
      "complexity": {
        "noNestedTernary": "off"
      },
      "import": {
        "noNodejsModules": "off"
      },
      "javascript": {
        "noVar": "error",
        "preferTemplate": "error"
      },
      "typescript": {
        "noExplicitAny": "off",
        "noNonNullAssertion": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "quoteStyle": "double"
  },
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      ".astro"
    ]
  }
}