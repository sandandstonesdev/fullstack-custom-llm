---// index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ValkeyChatWindow from '../components/ValkeyChatWindow.astro';
import type { Message } from '../types/index';

const initialMessages: Message[] = [
  { text: "Czesc jestem modelem jezykowym wpisz krotki prompt.", isUser: false },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chatbot App</title>
    <meta name="description" content="Chat with our AI Assistant" />
  </head>
  <body class="min-h-screen bg-gray-50">
    <BaseLayout title="Chatbot App">
      <main class="container mx-auto p-4 max-w-4xl">
      <h1 class="text-2xl font-bold mb-6 text-gray-800">Chat with our AI Assistant</h1>

      <ValkeyChatWindow messages={initialMessages} />
    </main>
    </BaseLayout>
  </body>
</html>

<style>
  /* Add any page-specific styles here */
  body {
    font-family: system-ui, -apple-system, sans-serif;
  }
</style>
